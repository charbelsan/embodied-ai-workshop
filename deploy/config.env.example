# Copy to deploy/config.env and edit. Every value can also be overridden from the environment.
REGION=us-east-1                         # a region with g6e capacity (us-east-1, us-east-2, us-west-2, eu-west-1 ...)
INSTANCE_TYPES="g6e.4xlarge g6e.8xlarge g6e.2xlarge"   # tried in this order (same NVIDIA L40S GPU)
AZS=""                                   # AZs to try, e.g. "us-east-1a us-east-1b"; empty = every AZ of the default VPC
PREFIX=vinci-workshop                    # name/tag prefix of every AWS resource created by these scripts
EVENT=vinci-workshop                     # event name (tag + name of the team outputs folder)
KEY_NAME=vinci-workshop                  # EC2 key pair for the organizers' SSH (created by setup_account.sh if missing)
ADMIN_CIDR=                              # organizers' IP for SSH, e.g. 203.0.113.4/32 (empty: your current public IP)
PARTICIPANT_CIDR=                        # venue network for DCV (port 8443); empty = add it later with allow_cidr.sh
ROOT_GB=200                              # disk of each machine (GB, gp3)
BASE_AMI=                                # build_image.sh: empty = latest Canonical Ubuntu 22.04 LTS amd64
OUTPUT_BUCKET=                           # optional S3 bucket: team submissions + outputs copied before destroy (created if missing)
STATE_DIR=                               # local state (credentials, key, image id); empty = deploy/state
