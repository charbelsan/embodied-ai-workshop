# Defaults of /etc/vinci/workshop.env (install_workshop.sh sets the paths; keep the other keys as they are)
WS_DIR=/home/ubuntu/vinci-workshop          # rewritten by install_workshop.sh
FIRST_ENV_READY_RE="INTERACTIVE_READY"
FIRST_ENV_MOTION_RE="FIRST_MOTION"
ISAAC_WINDOW_RE="Isaac Sim"
SERVICE_HEADLESS_ARGS="--headless"
SERVICE_HEALTH_URL="http://127.0.0.1:8765/observe"
SMOKE_CELLS=0
RESET_KILL_RE="pcgr_server_supervisor|skill_server|interactive\.py|jupyter|ipykernel|isaaclab|rsl_rl|dagger_|train_|challenge_eval|score_dev"
# Team outputs are copied to S3 before a machine is destroyed (deploy/team.sh destroy). Empty = no copy.
PERSIST_BUCKET=
PERSIST_REGION=
